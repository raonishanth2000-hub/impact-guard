# Copy to .env and adjust. Never commit real values.
# AWS credentials are NOT set here - boto3 resolves them from the standard
# provider chain (IAM role on Lambda, `aws configure` / SSO locally).

# ---- Data source -------------------------------------------------------
# demo = generated sample events (no AWS needed). aws = live CloudTrail.
DATA_SOURCE=demo

# ---- AWS ---------------------------------------------------------------
AWS_REGION=ap-south-1

# ---- Bedrock -----------------------------------------------------------
# Set BEDROCK_ENABLED=false to skip Bedrock entirely and always use the
# deterministic explanation (useful for offline demos).
BEDROCK_ENABLED=true

# Bedrock model availability differs by region, so this is configured separately.
BEDROCK_REGION=ap-south-1

# Bedrock can authenticate as a DIFFERENT account from the one CloudTrail is
# read from: model access is granted per account, so the account holding the
# events is not always the account permitted to explain them. Name an AWS CLI
# profile here; leave empty to use the same credentials as everything else.
BEDROCK_PROFILE=

# The model must be ENABLED for your account under Bedrock > Model access.
# Some regions require a region-prefixed inference profile instead of a bare
# model id, e.g. apac.anthropic.claude-... or us.anthropic.claude-...
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=1400
BEDROCK_TEMPERATURE=0.2

# ---- Limits ------------------------------------------------------------
MAX_LOOKBACK_MINUTES=360
MAX_EVENTS=200
MAX_EVENTS_TO_EXPLAIN=8

# ---- API ---------------------------------------------------------------
# Lock this down to your frontend origin in anything beyond a local demo.
CORS_ALLOW_ORIGIN=*
